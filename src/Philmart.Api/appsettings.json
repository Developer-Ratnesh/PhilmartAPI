{
  "ConnectionStrings": {
    "_comment": "Connect as a login mapped to the philmart_app database role. NOT db_owner and NOT sysadmin — Row Level Security does not apply to either, and the whole tenancy layer would silently disappear (Agreement clause 9.1).",
    "Philmart": "Server=localhost;Database=Philmart;User Id=philmart_app_login;Password=<from-user-secrets>;TrustServerCertificate=True;MultipleActiveResultSets=False;Encrypt=True"
  },
  "Auth": {
    "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
    "Audience": "api://philmart"
  },
  "Cors": {
    "Origins": [ "http://localhost:3000" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/philmart-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "AllowedHosts": "*"
}
